{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.86", "--headless", "--isolated"],
      "disabled": false,
      "autoApprove": []
    },
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ],
      "timeout": 100000,
      "transport": "stdio",
      "disabled": false,
      "autoApprove": []
    }
  }
}
